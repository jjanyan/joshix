{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "round", "reviewer", "promptDigest", "review"],
  "properties": {
    "schemaVersion": {"const": 2},
    "gate": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 1, "maximum": 2},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedProvider", "usedProvider", "path", "attempts", "fallback", "session"],
      "properties": {
        "requestedProvider": {"enum": ["claude", "codex"]},
        "usedProvider": {"enum": ["claude", "codex"]},
        "path": {"enum": ["cross-provider-cli", "same-model-native", "same-model-cli"]},
        "attempts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requested", "fallback"],
          "properties": {
            "requested": {"type": "integer", "minimum": 1, "maximum": 2},
            "fallback": {"type": "integer", "minimum": 0, "maximum": 2}
          }
        },
        "fallback": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["reason"],
          "properties": {
            "reason": {"enum": ["unavailable", "unauthorized", "timeout", "oversized", "nonzero", "malformed"]}
          }
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "mode"],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "mode": {"enum": ["started", "resumed", "replaced"]}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"fallback": {"type": "null"}}},
          "then": {"properties": {"attempts": {"properties": {"fallback": {"const": 0}}}}}
        },
        {
          "if": {"properties": {"fallback": {"type": "object"}}},
          "then": {"properties": {"attempts": {"properties": {"fallback": {"minimum": 1}}}}}
        }
      ]
    },
    "promptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "review": {"$ref": "review-result.schema.json"}
  }
}
