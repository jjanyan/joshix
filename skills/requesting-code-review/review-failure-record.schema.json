{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "round", "requestedProvider", "diagnostic"],
  "properties": {
    "schemaVersion": {"const": 1},
    "gate": {"type": "string", "minLength": 1},
    "round": {"type": "integer", "minimum": 1, "maximum": 2},
    "requestedProvider": {"enum": ["claude", "codex"]},
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "classification", "attempts", "exitStatus", "signal", "elapsedMs"],
      "properties": {
        "stage": {"enum": ["launcher", "runner", "provider"]},
        "classification": {"enum": ["sandboxed", "launcher", "configuration-stale", "unavailable", "unauthorized", "timeout", "oversized", "session-unavailable", "nonzero", "malformed", "configuration", "internal"]},
        "attempts": {"type": "integer", "minimum": 0, "maximum": 2},
        "exitStatus": {"type": ["integer", "null"]},
        "signal": {"type": ["string", "null"], "maxLength": 64},
        "elapsedMs": {"type": "integer", "minimum": 0},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 512}
      }
    }
  }
}
